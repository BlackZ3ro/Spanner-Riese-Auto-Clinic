@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@{
    var steps = Spanner.Web.Pages.Track.IndexModel.Steps;
    string PhaseLabel(string? key) => steps.FirstOrDefault(s => s.Key == key)?.Label ?? "Book-in & Inspection";
    var lowStockCount = Model.StockItems.Count(i => i.QuantityOnHand <= i.ReorderLevel);
    var inWork = Model.OpenBookings.Count(b => b.Phase is "labor_in_progress" or "reassembly");
    var ready = Model.OpenBookings.Count(b => b.Phase == "ready_for_pickup");
}

<div class="sp-page-head">
    <div>
        <h1>Today</h1>
        <p>@DateTime.Now.ToString("dddd, d MMMM yyyy") · Riese Auto Clinic</p>
    </div>
    <a asp-page="/Bookings/Create" class="btn btn-primary">+ Book in a vehicle</a>
</div>

<div class="sp-stats">
    <div class="sp-stat"><div class="n">@Model.OpenBookings.Count</div><div class="l">Vehicles in the workshop</div></div>
    <div class="sp-stat orange"><div class="n">@inWork</div><div class="l">Being worked on</div></div>
    <div class="sp-stat green"><div class="n">@ready</div><div class="l">Ready for pickup</div></div>
    <div class="sp-stat orange"><div class="n">@lowStockCount</div><div class="l">Parts at or below reorder level</div></div>
</div>

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<div class="row">
    <section class="col-md-6 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="h4">Current bookings</h2>
            <a asp-page="/Bookings/Create" class="btn btn-sm btn-primary">Book in a vehicle</a>
        </div>
        <p class="text-muted">Bookings that haven't been closed out yet.</p>
        @if (Model.OpenBookings.Count == 0)
        {
            <p><em>No open bookings.</em></p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Registration</th>
                        <th>Phase</th>
                        <th>Booked</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.OpenBookings)
                    {
                        <tr>
                            <td><a asp-page="/Bookings/Details" asp-route-id="@booking.Id">@booking.Brand @booking.Model @(booking.Year is not null ? $"({booking.Year})" : "")</a></td>
                            <td>@booking.Registration</td>
                            <td><span class="sp-pill p-@(booking.Phase ?? "booked_in")">@PhaseLabel(booking.Phase)</span></td>
                            <td>@booking.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="col-md-6 mb-4">
        <h2 class="h4">Stock levels</h2>
        <p class="text-muted">Rows highlighted in gold are at or below their reorder level.</p>
        @if (Model.StockItems.Count == 0)
        {
            <p><em>No stock items.</em></p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Part</th>
                        <th>SKU</th>
                        <th>On hand</th>
                        <th>Reorder at</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.StockItems)
                    {
                        var lowStock = item.QuantityOnHand <= item.ReorderLevel;
                        <tr class="@(lowStock ? "table-warning" : "")">
                            <td>@item.Name</td>
                            <td>@item.Sku</td>
                            <td>@item.QuantityOnHand</td>
                            <td>@item.ReorderLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

<p class="text-muted small">
    See a booking's own page for its jobs, parts and running total, or
    <a asp-page="/Vehicles/Search">search vehicle history</a>.
</p>

@section Scripts {
    <script>
        // FR-09: live-refresh the dashboard when bookings/stock change anywhere -
        // this browser, another tab, or (once mobile adds its own Realtime
        // subscriptions) the mobile app. Reload-on-change is the simplest correct
        // approach (NFR-01) rather than hand-patching individual table rows.
        const liveSource = new EventSource('/Realtime/Stream');
        liveSource.onmessage = () => location.reload();
    </script>
}
