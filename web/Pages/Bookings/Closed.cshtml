@page
@model Spanner.Web.Pages.Bookings.ClosedModel
@{
    ViewData["Title"] = "Closed bookings";
}

<h1 class="mb-4">Closed bookings</h1>
<p class="text-muted">Finalized vehicles. Open one and enter your password to reopen and edit it.</p>

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.ClosedBookings.Count == 0)
{
    <p><em>No closed bookings yet.</em></p>
}
else
{
    <table class="table table-sm table-striped col-md-8">
        <thead>
            <tr>
                <th>Vehicle</th>
                <th>Registration</th>
                <th>Customer</th>
                <th>Finalized</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.ClosedBookings)
            {
                <tr>
                    <td><a asp-page="/Bookings/Details" asp-route-id="@booking.Id">@booking.Brand @booking.Model (@booking.Year)</a></td>
                    <td>@booking.Registration</td>
                    <td>@(string.IsNullOrWhiteSpace(booking.CustomerName) ? "Not recorded" : booking.CustomerName)</td>
                    <td>@(booking.ClosedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="mt-3"><a asp-page="/Index">&larr; Back to dashboard</a></p>
