@page
@model Spanner.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book in a vehicle";
}

<h1 class="mb-4">Book in a vehicle</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" type="number" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TransmissionType" class="form-label">Transmission</label>
        <select asp-for="TransmissionType" class="form-select" asp-items="CreateModel.TransmissionOptions">
            <option value="">-- Select --</option>
        </select>
        <span asp-validation-for="TransmissionType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EngineSize" class="form-label">Engine size (optional)</label>
        <input asp-for="EngineSize" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="EngineCode" class="form-label">Engine code (optional)</label>
        <input asp-for="EngineCode" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Registration" class="form-label"></label>
        <input asp-for="Registration" class="form-control text-uppercase" />
        <span asp-validation-for="Registration" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Kilometers" class="form-label">Kilometers on the clock</label>
        <input asp-for="Kilometers" class="form-control" type="number" />
        <span asp-validation-for="Kilometers" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save booking</button>
    <a asp-page="/Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
