@page "{id:guid}"
@model Spanner.Web.Pages.Jobs.DetailsModel
@{
    ViewData["Title"] = "Job details";
}

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

@if (Model.Job is { } job)
{
    <h1 class="mb-1">@job.JobType</h1>
    @if (Model.Booking is { } booking)
    {
        <p class="text-muted">
            On <a asp-page="/Bookings/Details" asp-route-id="@booking.Id">@booking.Brand @booking.Model (@booking.Registration)</a>
        </p>
    }

    <p>
        Status:
        <span class="badge @(job.Status == "completed" ? "bg-success" : "bg-secondary")">@job.Status</span>
        @if (job.CompletedAt is { } completedAt)
        {
            <span class="text-muted">- completed @completedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
        }
    </p>

    @if (!string.IsNullOrEmpty(Model.SaveError))
    {
        <div class="alert alert-danger">@Model.SaveError</div>
    }

    <form method="post" class="col-md-5">
        <div class="mb-3">
            <label asp-for="LabourHours" class="form-label">Labour hours</label>
            <input asp-for="LabourHours" class="form-control" type="number" step="0.25" />
            <span asp-validation-for="LabourHours" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LabourRate" class="form-label">Labour rate (per hour)</label>
            <input asp-for="LabourRate" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="LabourRate" class="text-danger"></span>
        </div>

        @if (Model.LabourCost is { } cost)
        {
            <p class="fs-5">Labour cost: <strong>@cost.ToString("C")</strong></p>
        }

        <button type="submit" asp-page-handler="SaveHours" class="btn btn-outline-primary">Save hours</button>
        <button type="submit" asp-page-handler="MarkComplete" class="btn btn-primary">Mark job complete</button>
    </form>

    <p class="mt-4"><a asp-page="/Bookings/Details" asp-route-id="@job.BookingId">&larr; Back to booking</a></p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
