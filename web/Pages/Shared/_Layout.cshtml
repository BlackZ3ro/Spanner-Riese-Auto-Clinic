<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spanner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Spanner.Web.styles.css" asp-append-version="true" />
</head>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix, bool exact = false) =>
        (exact ? path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || (prefix == "/" && path == "/Index")
               : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var userName = User.Identity?.Name ?? "";
}
<body class="@(signedIn ? "sp-app" : "sp-public")">
    @if (signedIn)
    {
        <aside class="sp-side">
            <a class="sp-brand" asp-page="/Index">
                <span class="sp-logo" aria-hidden="true">R</span>
                <span><span class="sp-brand-name">Riese Auto Clinic</span><span class="sp-brand-sub">Spanner workshop system</span></span>
            </a>
            <nav class="sp-nav">
                <a class="@Active("/", exact: true)" asp-page="/Index">Today</a>
                <a class="@Active("/Bookings/Create")" asp-page="/Bookings/Create">Book in a vehicle</a>
                <a class="@Active("/Stock")" asp-page="/Stock/Index">Stock</a>
                <a class="@Active("/Vehicles")" asp-page="/Vehicles/Search">Vehicle history</a>
                <a class="@Active("/Bookings/Closed")" asp-page="/Bookings/Closed">Closed bookings</a>
                <a asp-page="/Track/Index" target="_blank">Customer tracking ↗</a>
            </nav>
            <form method="post" asp-page="/Account/Logout" class="sp-user">
                <span class="sp-avatar">@(userName.Length > 0 ? char.ToUpperInvariant(userName[0]) : '?')</span>
                <span class="sp-user-name">@userName</span>
                <button type="submit" class="btn btn-sm sp-logout">Log out</button>
            </form>
        </aside>
        <div class="sp-main">
            <main role="main" class="sp-content">
                @RenderBody()
            </main>
            <footer class="sp-foot">&copy; 2026 Spanner · Riese Auto Clinic · <a asp-page="/Privacy">Privacy</a></footer>
        </div>
    }
    else
    {
        <header class="sp-topbar">
            <a class="sp-brand" asp-page="/Index">
                <span class="sp-logo" aria-hidden="true">R</span>
                <span><span class="sp-brand-name">Riese Auto Clinic</span><span class="sp-brand-sub">Spanner workshop system</span></span>
            </a>
        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <footer class="sp-foot text-center">&copy; 2026 Spanner · Riese Auto Clinic · <a asp-page="/Track/Index">Track your vehicle</a> · <a asp-page="/Privacy">Privacy</a></footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
