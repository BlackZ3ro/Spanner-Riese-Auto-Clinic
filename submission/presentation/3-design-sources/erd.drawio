tryDy=0;" edge="1" parent="1" source="auth_users.id" target="profiles.id"><mxGeometry relative="1" x="0.487" y="0" as="geometry"><Array as="points"><mxPoint x="40" y="498.0"/><mxPoint x="40" y="638.0"/></Array></mxGeometry></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#8a97a8;" vertex="1" parent="1"><mxGeometry x="378" y="560" width="290" height="336" as="geometry"></mxGeometry></mxCell><mxCell id="legT" value="&lt;b&gt;How to read this ERD&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="392" y="568" width="260" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="legE0" value="" style="endArrow=ERmandOne;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#1f3a5f;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="612" as="sourcePoint"/><mxPoint x="468" y="612" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legL0" value="exactly one" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="600" width="170" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="legE1" value="" style="endArrow=ERzeroToOne;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#1f3a5f;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="646" as="sourcePoint"/><mxPoint x="468" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legL1" value="zero or one" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="634" width="170" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="legE2" value="" style="endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=14;html=1;strokeColor=#1f3a5f;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="680" as="sourcePoint"/><mxPoint x="468" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legL2" value="zero or many" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="668" width="170" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="legN" value="Each line runs from the primary key (&lt;b&gt;PK&lt;/b&gt;) of the &amp;quot;one&amp;quot; table to the foreign key (&lt;b&gt;FK&lt;/b&gt;) that points at it. The symbol at each end says how many rows can be on that side.&lt;br&gt;&lt;br&gt;&lt;b&gt;Customers never log in.&lt;/b&gt; Staff (&lt;b&gt;auth.users&lt;/b&gt;, role in &lt;b&gt;profiles&lt;/b&gt;) book the car in: &lt;b&gt;bookings.created_by&lt;/b&gt; records who. The customer's details are typed into the booking and also saved in &lt;b&gt;customers&lt;/b&gt;, so a returning customer can be looked up.&lt;br&gt;&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; = unique. An optional foreign key gives &amp;quot;zero or one&amp;quot; on the parent side." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="392" y="716" width="262" height="176" as="geometry"></mxGeometry></mxCell><mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;Spanner ERD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;Supabase schema (PostgreSQL), 16 Oct 2026. Crow's-foot notation. New: bookings.created_by (migration 0010).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1190" y="40" width="640" height="50" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
